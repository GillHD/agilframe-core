# .env.example — скопируйте в .env и заполните секреты.
# Никогда не коммитьте .env в git.

# --- база ---
PORT=8787
AGIL_PUBLIC_ORIGIN=https://calls.example.com
AGIL_DATA_DIR=./.data
# Optional PostgreSQL connection string for tenant chat history (historyStorage=postgres).
# Keep credentials in deployment secrets, and leave empty for installations without PostgreSQL.
# AGIL_CHAT_POSTGRES_URL=

# --- кастомные домены (white-label; TLS — внешний Caddy/HAProxy) ---
# Цель CNAME и значение по умолчанию для /v1/admin/domain (host из PUBLIC_ORIGIN)
# AGIL_DOMAIN_TARGET=calls.example.com
# AGIL_DOMAIN_DNS_TIMEOUT_MS=5000
# Первая верификация требует TXT _agil-calls.<domain> = "agil-verify=<token>";
# CNAME без TXT принимается только как re-check уже verified домена.
# On-demand TLS approval hook (/v1/domain/ask). AGIL_DOMAIN_ASK_SECRET ОБЯЗАТЕЛЕН:
# пустой секрет = hook всегда 403 (on-demand TLS не работает). Caddy передаёт
# его в ?key=, а публичный путь закрывается `respond 404` в site-block.
# AGIL_DOMAIN_ASK_SECRET=CHANGE_ME
# Host, на который отвечает hook: внутренний ask Caddy идёт на 127.0.0.1,
# внешний запрос через site-block сохраняет публичный Host и получает 403.
# `*` отключает проверку — только с секретом и path-block.
# AGIL_DOMAIN_ASK_HOSTS=127.0.0.1,localhost,::1
# ACL проверяет TCP-peer сокета (X-Forwarded-For игнорируется). По умолчанию
# loopback; пустое значение тоже loopback, а не «все». Непустой список без
# валидных IP/CIDR (опечатка/хостнейм/33) = 403 и отказ старта. В Docker запрос
# от Caddy приходит с bridge-gateway (например 172.17.0.1) — укажите его/CIDR
# или используйте network_mode: host:
# AGIL_DOMAIN_ASK_ALLOW_IPS=127.0.0.1,::1
# Неверные секреты ограничиваются per-client, успешные ask — per-peer, поэтому
# внешний флуд не исчерпывает лимит Caddy.
# AGIL_DOMAIN_ASK_RATE_LIMIT_PER_MIN=120
# HSTS (выставляет Node при AGIL_TRUST_PROXY=1). includeSubDomains для
# customer-хостов по умолчанию выключен: его нельзя отозвать до истечения max-age.
# AGIL_HSTS_MAX_AGE_SEC=15552000
AGIL_HSTS_INCLUDE_SUBDOMAINS=1
AGIL_HSTS_INCLUDE_SUBDOMAINS_CUSTOM=0
# WebSocket Origin allowlist: AGIL_PUBLIC_ORIGIN + integrations.allowedOrigins +
# verified custom domain. Отключение — только legacy escape hatch.
AGIL_WS_ORIGIN_ENFORCE=1
# AGIL_WS_ALLOWED_ORIGINS=https://portal.example.com

# --- auth ---
AGIL_TOKEN_SECRET=CHANGE_ME_32_BYTES_MIN
AGIL_API_KEYS=REPLACE_WITH_RANDOM_API_KEY:demo
AGIL_ALLOW_ANONYMOUS=0
AGIL_TRUST_PROXY=1
AGIL_IP_SALT=CHANGE_ME_RANDOM

# --- SSO / OIDC (вход в панель по authorization code + PKCE) ---
# Секрет OAuth-клиента задаётся под именем, указанным в integrations.identity.clientSecretEnv.
# Для тенанта demo (соглашение доступно только для канонического lower-case id):
# AGIL_OIDC_CLIENT_SECRET_DEMO_KEYCLOAK=CHANGE_ME
# Явная карта нужна для legacy/глобального имени или id с -/./_ (ключ — точный id тенанта):
# AGIL_OIDC_TENANT_SECRETS="demo=AGIL_OIDC_CLIENT_SECRET,acme=AGIL_OIDC_CLIENT_SECRET_ACME"
# AGIL_OIDC_CLIENT_SECRET=CHANGE_ME
# Время жизни незавершённого входа (state/nonce/PKCE) и admin-сессии панели, сек:
# AGIL_OIDC_STATE_TTL_SEC=600
AGIL_ADMIN_SESSION_TTL_SEC=900
# Привязка state к браузеру HttpOnly-cookie для same-origin панели (login CSRF).
# Выключите (0), если start и callback обслуживаются разными хостами через прокси.
# AGIL_OIDC_COOKIE_BINDING=1

# --- сеть ---
AGIL_ICE_SERVERS=[{"urls":"stun:turn.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"agil","credential":"CHANGE_ME"}]

# --- SFU (LiveKit) и медиаплоскость (deploy/livekit, docs/operations.md) ---
# AGIL_SFU_URL=wss://sfu.example.com
# AGIL_SFU_CONTROL_URL=http://sfu.internal:7880
# AGIL_SFU_API_KEY=CHANGE_ME
# AGIL_SFU_API_SECRET=CHANGE_ME
# AGIL_SFU_ENABLED=1
# Необязательно. Адреса входа для зарегистрированных нод одного кластера LiveKit.
# AGIL_SFU_NODE_URLS={"demo":{"sfu-a":"wss://sfu-a.example.com","sfu-b":"wss://sfu-b.example.com"}}
# Ёмкость галереи: low=2, standard=6, high=12 удалённых видео на клиента (9+ участников).
# По умолчанию standard (SFU 8–16 vCPU/16 GB). Текущий пилот 1 vCPU/2 GB ОБЯЗАН
# выставить low явно; без этого он получит standard-бюджет.
# AGIL_SFU_PROFILE=low
# Список узлов для ops-check: НЕ читается сервером, только скриптом проверки.
# AGIL_SFU_NODES=https://sfu-1.internal:7880,https://sfu-2.internal:7890

# --- egress-воркер (deploy/egress, docs/egress-production.md) ---
# AGIL_EGRESS_URL=https://sfu.example.com
# AGIL_EGRESS_API_KEY=CHANGE_ME
# AGIL_EGRESS_API_SECRET=CHANGE_ME
# AGIL_EGRESS_ENABLED=1
# Health-порт самого воркера для ops-check (это НЕ Twirp-база!).
# AGIL_EGRESS_HEALTH_URL=http://127.0.0.1:8080/
# Подписанные ссылки на HLS/MP4 (docs/egress-production-s3.md): HMAC + TTL,
# бакет остаётся приватным, ключи S3 в URL не попадают.
# AGIL_EGRESS_PLAYBACK_ENABLED=1
# auto сохраняет прежний выбор (S3 при заданных реквизитах, иначе local).
# AGIL_EGRESS_PLAYBACK_BACKEND=auto
# AGIL_EGRESS_PLAYBACK_DIR=/app/egress-out
# AGIL_EGRESS_PLAYBACK_SECRET=CHANGE_ME_32_BYTES
# AGIL_EGRESS_PLAYBACK_TTL_SEC=900
# Включайте удаление из архива только с подходящими правами на файлы.
# AGIL_EGRESS_ARCHIVE_DELETE_ENABLED=0
# Рекомендуется отдельный ключ Core для чтения бакета egress-воркера.
# AGIL_EGRESS_S3_ENDPOINT=https://s3.example.com
# AGIL_EGRESS_S3_REGION=ru-msk
# AGIL_EGRESS_S3_BUCKET=agil-recordings
# AGIL_EGRESS_S3_ACCESS_KEY=CHANGE_ME
# AGIL_EGRESS_S3_SECRET_KEY=CHANGE_ME
# AGIL_EGRESS_S3_FORCE_PATH_STYLE=true
# Порог «зависших» egress-сессий для POST /v1/admin/egress/cleanup (4 ч).
# AGIL_EGRESS_STUCK_AFTER_SEC=14400

# --- Маршрутизация Edge/комнат → RTMP/HLS (docs/routing.md) ---
# Полный RTMP-URL со stream key, на который ссылается secretRef маршрута
# (пространство AGIL_ROUTE_SECRET_*; значение читается только из снапшота env).
# AGIL_ROUTE_SECRET_DEMO_HALL=rtmp://live.example/app/CHANGE_ME
# Allowlist для machine-поверхности /v1/edge/join (и cluster/node enrollment).
# AGIL_ENROLL_ALLOW_IPS=203.0.113.0/24

# --- SIP/PSTN (LiveKit SIP, опционально; docs/sip.md) ---
# По умолчанию выключено. Нужны также features.sipDialIn и scale.sip.enabled.
AGIL_SIP_ENABLED=0
# AGIL_SIP_URL=https://livekit.example.com
# AGIL_SIP_API_KEY=CHANGE_ME
# AGIL_SIP_API_SECRET=CHANGE_ME

# --- безопасность ---
AGIL_GEO_PROVIDER=header
AGIL_GEO_LOOKUP_TIMEOUT_MS=1200
AGIL_FILE_TTL_SEC=86400
AGIL_MAX_UPLOAD_MB=25
# Записи и E2EE/SCIM (см. docs/security.md, docs/operations.md §7)
# AGIL_RECORDINGS_DIR=./.data/recordings
# AGIL_MAX_RECORDING_MB=200
# AGIL_E2EE_SECRET=CHANGE_ME
# AGIL_SCIM_TOKEN=CHANGE_ME
# AGIL_PLATFORM_KEY=CHANGE_ME
# AGIL_INTEGRITY_URL=
# AGIL_INTEGRITY_KEY=

# --- liveness и антивирусная проверка загрузок (free/OSS; docs/liveness-av.md) ---
# Обе функции выключены для тенанта по умолчанию (security.liveness /
# security.avScan). AV дополнительно требует настроенный движок; без него файлы
# сохраняются без скана. Платные API не используются.
# Liveness: сервер выдаёт задание, браузер проверяет локально (видео не уходит).
# AGIL_LIVENESS_ENGINE=challenge          # challenge | external (self-hosted)
# AGIL_LIVENESS_URL=                     # http://liveness:8080 (external)
# AGIL_LIVENESS_KEY=
# AGIL_LIVENESS_TIMEOUT_MS=5000
# AGIL_LIVENESS_TTL_SEC=180
# AGIL_LIVENESS_MAX_ATTEMPTS=2
# AV: clamd INSTREAM (TCP или unix-socket) и/или YARA CLI.
# AGIL_CLAMAV_HOST=                      # пусто и нет SOCKET = ClamAV выключен
# AGIL_CLAMAV_PORT=3310
# AGIL_CLAMAV_SOCKET=                    # /var/run/clamav/clamd.ctl — приоритетнее host/port
# AGIL_CLAMAV_TIMEOUT_MS=10000
# AGIL_YARA_RULES=                       # путь к .yar/.yara; пусто = YARA выключена
# AGIL_YARA_BIN=yara
# AGIL_AV_CONCURRENCY=1
# AGIL_AV_QUEUE_LIMIT=50
# AGIL_AV_QUEUE_DIR=./.data/av-queue          # durable spool для принятых async-сканов
# AGIL_QUARANTINE_DIR=./.data/quarantine

# --- STT / AI (опционально) ---
AGIL_STT_URL=
AGIL_STT_KEY=
AGIL_STT_MODEL=whisper-1
# Ключи интеграций задаются в серверных namespace'ах; конфиг тенанта хранит
# только ИМЯ переменной (docs/security.md §2.11). Произвольные имена
# (AGIL_TOKEN_SECRET, AGIL_PLATFORM_KEY, …) отклоняются и не читаются.
#   AGIL_INTEGRATION_* — session.aiAgent / knowledgeAgent / inCallAgent / providers.*.apiKeyEnv
#   AGIL_WEBHOOK_*     — integrations.webhooks[].secretEnv (HMAC)
#   AGIL_SIEM_*        — integrations.siem.secretEnv (HMAC)
#   AGIL_SFU_*         — scale.sfu.apiKeyEnv / apiSecretEnv
#   AGIL_TURN_*        — scale.turn[].credentialEnv
# AGIL_INTEGRATION_AI_AGENT_KEY=
# AGIL_INTEGRATION_KNOWLEDGE_AGENT_KEY=
# AGIL_INTEGRATION_INCALL_AGENT_KEY=
# Исторические имена (принимаются для совместимости, лучше не использовать):
# AGIL_AI_AGENT_KEY=
# AGIL_KNOWLEDGE_AGENT_KEY=
# AGIL_INCALL_AGENT_KEY=

# --- локальные STT и перевод (бесплатно, без облака; docs/stt-translation-local.md) ---
# Ничего не включено по умолчанию и никакие модели не скачиваются автоматически.
# STT_PROVIDER: local | browser | none | remote (remote = legacy AGIL_STT_URL).
# STT_PROVIDER=local
# STT_LOCAL_ENGINE=auto                  # auto | whisper-cpp | faster-whisper
# STT_LOCAL_BINARY=whisper-cli           # whisper.cpp CLI on PATH or absolute
# STT_LOCAL_MODEL_PATH=agil/core/models/whisper/ggml-small.bin
# STT_LOCAL_MODEL=small                  # faster-whisper model id/dir
# STT_LOCAL_PYTHON=python3               # Windows default: python
# STT_LOCAL_THREADS=4
# STT_LOCAL_GPU=0
# STT_LOCAL_TIMEOUT_MS=120000
# STT_LOCAL_FFMPEG=                      # default: ffmpeg from PATH
# AGIL_STT_ALLOW_DOWNLOAD=0              # 1 = allow one-time HF download if weights are missing
#
# TRANSLATE_PROVIDER: local | llm | none. `llm` is an optional paid/self-hosted
# adapter and is refused when PRIVACY_MODE=local.
# TRANSLATE_PROVIDER=local
# TRANSLATE_LOCAL_ENGINE=opus-mt         # opus-mt | marian | auto
# TRANSLATE_LOCAL_MODEL_DIR=agil/core/models/translate   # ru-en/ + en-ru/
# TRANSLATE_LOCAL_PYTHON=python3
# TRANSLATE_LOCAL_TIMEOUT_MS=60000
# TRANSLATE_LOCAL_GPU=0
# TRANSLATE_LOCAL_MAX_CHARS=800
# TRANSLATE_LLM_PROVIDER=                # openai-compatible | anthropic | ollama
# TRANSLATE_LLM_URL=
# TRANSLATE_LLM_KEY=
# TRANSLATE_LLM_MODEL=
# TRANSLATE_LLM_TIMEOUT_MS=20000
#
# Приватность/хранение расшифровки:
# PRIVACY_MODE=standard                 # local = запрещает внешние STT/MT/LLM
# TRANSCRIPT_RETENTION_SEC=0            # 0 = на время жизни комнаты
# TRANSCRIPT_CONSENT_REQUIRED=0          # 1 = явное согласие участника

# --- статика (по умолчанию dist-каталоги репозитория) ---
# AGIL_STATIC_DIR=./apps/demo/dist
# AGIL_EDITOR_DIR=./apps/editor/dist
# AGIL_DASHBOARD_DIR=./apps/dashboard/dist
# AGIL_SDK_DIR=./packages/sdk/dist
# AGIL_WIDGET_DIR=./packages/widget/dist

# --- публикация API-документации и MCP (см. docs/api-exposure.md) ---
AGIL_DOCS_ENABLED=1
# Writable CMS directory. Keep empty for AGIL_DATA_DIR/docs.
# For Core HA, mount the same shared directory on every Core and set this path.
# AGIL_DOCS_DATA_DIR=/mnt/agil-wiki
# AGIL_DOCS_ALLOW_IPS=10.0.0.0/8,192.168.0.0/16,127.0.0.1
# AGIL_DOCS_PORT=8790
# AGIL_DOCS_HOST=127.0.0.1
AGIL_ADMIN_API_ENABLED=1
# AGIL_ADMIN_ALLOW_IPS=10.0.0.0/8
AGIL_MCP_HTTP_ENABLED=0
# AGIL_MCP_HTTP_PORT=8791
# AGIL_MCP_HTTP_TOKEN=CHANGE_ME
# AGIL_MCP_HTTP_ALLOW_IPS=10.0.0.0/8
AGIL_MCP_MODE=full

# --- TURN (docker-compose) ---
TURN_REALM=agil.local
TURN_USER=agil
TURN_PASSWORD=CHANGE_ME

# --- помощник панели (маскот) на DeepSeek (OpenAI-compatible) ---
AGIL_DEEPSEEK_API_KEY=
AGIL_DEEPSEEK_MODEL=deepseek-chat
AGIL_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGIL_DEEPSEEK_TIMEOUT_MS=20000
# --- демо-режим гео по заголовку (в проде использовать ipapi/edge) ---
AGIL_GEO_HEADER_ALLOW=1
# --- лимит join на IP+комнату в минуту (офисный NAT: 200 мест + запас) ---
AGIL_JOIN_RATE_LIMIT_PER_MIN=300

# --- эксплуатация: скрипты/мониторинг (docs/operations.md) ---
# ВНИМАНИЕ: эти переменные НЕ читаются сервером — их используют
# scripts/ops-check.mjs, scripts/backup-data.sh и деплой-обвязка.
# AGIL_APP_URL=https://calls.example.com
# AGIL_BACKUP_DIR=/opt/backups/agil
# AGIL_BACKUP_RETENTION_DAYS=14
# AGIL_BACKUP_KEEP=7
# AGIL_BACKUP_S3_URI=s3://agil-backups/calls/daily
# AGIL_BACKUP_S3_ENDPOINT_URL=https://s3.example.com
# AGIL_BACKUP_TEXTFILE=/var/lib/node_exporter/textfile/agil_backup.prom
# AGIL_REDIS_ADDRESS=127.0.0.1:6380
# AGIL_REDIS_CONTAINER=agil-sfu-redis-1
# AGIL_OPS_SSH=agil-ops@sfu-1.example.com
# AGIL_DOCKER_CONTAINER=agil-calls
# AGIL_DISK_PATH=/var/lib/docker/volumes/agil-calls_agil-data/_data
# AGIL_DISK_WARN_PCT=80
# AGIL_DISK_CRIT_PCT=90
# AGIL_MEM_WARN_PCT=85
# AGIL_MEM_CRIT_PCT=95
# AGIL_TLS_WARN_DAYS=21
# AGIL_TLS_CRIT_DAYS=7
