#!/usr/bin/env bash
# Cloud-init user data for the AGIL reference VMs (Ubuntu 22.04).
#
# Installs Docker Engine + Compose v2 and prepares /opt/agil. It does NOT clone
# the repository, does NOT generate or write secrets and does NOT start AGIL.
# Finish with the quickstart on the host:
#
#   git clone <your-repo> /opt/agil/src
#   cd /opt/agil/src/agil/infra/quickstart
#   sudo ./install.sh --domain calls.example.com --turn-ip $PUBLIC_IP --start
#
# No curl|bash: package keys are downloaded to files and verified by apt.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

log() { echo "[agil-user-data] $*"; }

retry() {
  local attempt
  for attempt in 1 2 3 4 5; do
    if "$@"; then return 0; fi
    log "retrying: $* (attempt $attempt)"
    sleep 10
  done
  return 1
}

log "installing base packages (${role})"
retry apt-get update -y
retry apt-get install -y ca-certificates curl gnupg jq git unzip make

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

. /etc/os-release
printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\n' \
  "$(dpkg --print-architecture)" "$VERSION_CODENAME" > /etc/apt/sources.list.d/docker.list

retry apt-get update -y
retry apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

cat > /etc/docker/daemon.json <<'EOF'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "20m",
    "max-file": "5"
  },
  "live-restore": true
}
EOF
systemctl enable docker
systemctl restart docker

# Ubuntu 22.04 AMIs ship the SSM agent as a snap. Enable it when present; it is
# how Session Manager reaches the VM when no SSH key is attached (enable_ssm).
log "enabling the preinstalled SSM agent (if present)"
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service >/dev/null 2>&1 || true

usermod -aG docker ubuntu || true

cat > /etc/sysctl.d/99-agil.conf <<'EOF'
net.core.somaxconn = 4096
net.ipv4.ip_local_port_range = 1024 65000
fs.file-max = 200000
EOF
sysctl --system >/dev/null

install -d -m 0755 /opt/agil
install -d -m 0755 /etc/agil
install -d -m 0755 /etc/motd.d

PUBLIC_IP="$(curl -fsS --max-time 3 http://169.254.169.254/latest/meta-data/public-ipv4 || true)"
INSTANCE_ID="$(curl -fsS --max-time 3 http://169.254.169.254/latest/meta-data/instance-id || true)"
AZ="$(curl -fsS --max-time 3 http://169.254.169.254/latest/meta-data/placement/availability-zone || true)"

cat > /etc/agil/quickstart.env <<EOF
# Descriptive hints only. Run agil/infra/quickstart/install.sh to generate the
# real .env (secrets, ICE list, API key). Never store secrets in user data.
AGIL_INSTANCE_ID=$INSTANCE_ID
AGIL_ROLE=${role}
AGIL_NODE_NAME=${node_name}
AGIL_PUBLIC_ORIGIN=${public_origin}
# Core base URL for node registration/heartbeat on this host. For the node role
# this is the core private IP (same VPC); use the public HTTPS origin when the
# node lives outside this VPC. Also see agil/infra/quickstart/node.env.example.
AGIL_CORE_URL=${core_url}
AGIL_HTTP_PORT=${core_port}
TURN_PORT=${turn_port}
TURN_MIN_PORT=${turn_min}
TURN_MAX_PORT=${turn_max}
TURN_EXTERNAL_IP=$PUBLIC_IP
AGIL_AVAILABILITY_ZONE=$AZ
EOF

cat > /etc/motd.d/agil <<EOF
AGIL ${role} host (${node_name})
  quickstart:  /opt/agil/src/agil/infra/quickstart
  hints:       /etc/agil/quickstart.env
  public IPv4: $PUBLIC_IP
  docker:      docker compose version
Finish with:
  git clone <your-repo> /opt/agil/src
  cd /opt/agil/src/agil/infra/quickstart
  # core host: ./install.sh --turn-ip $PUBLIC_IP --start
  # node host: cp node.env.example .env && docker compose -f docker-compose.node.yml \
  #              -f docker-compose.node-remote.yml up -d
EOF
chmod 0644 /etc/agil/quickstart.env /etc/motd.d/agil

log "done: docker $(docker --version 2>/dev/null || echo installed), public ip $PUBLIC_IP"
