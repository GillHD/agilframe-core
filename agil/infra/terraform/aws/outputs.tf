output "core_public_ip" {
  description = "Elastic public IPv4 of the core VM (point your domain here)."
  value       = aws_eip.core.public_ip
}

output "core_private_ip" {
  description = "Private IPv4 of the core VM."
  value       = aws_instance.core.private_ip
}

output "core_api_url" {
  description = "Core base URL reachable from outside the VPC (https via the proxy when domain_name is set, otherwise the EIP and core port). Use as AGIL_CORE_URL for remote nodes."
  value       = local.core_public_url
}

output "core_private_url" {
  description = "Core base URL inside the VPC (HTTP, core port). Use as AGIL_CORE_URL on node VMs in the same VPC."
  value       = local.core_private_url
}

output "core_instance_id" {
  description = "Core EC2 instance id."
  value       = aws_instance.core.id
}

output "node_public_ips" {
  description = "Elastic public IPv4s of node VMs (TURN/SFU)."
  value       = aws_eip.node[*].public_ip
}

output "node_private_ips" {
  description = "Private IPv4s of node VMs."
  value       = aws_instance.node[*].private_ip
}

output "node_instance_ids" {
  description = "Node EC2 instance ids."
  value       = aws_instance.node[*].id
}

output "public_origin" {
  description = "URL to use as AGIL_PUBLIC_ORIGIN. https requires a certificate on the proxy."
  value       = local.public_origin
}

output "dns_names" {
  description = "Created DNS names (empty when create_dns_records=false)."
  value = {
    core = local.dns_ready ? var.domain_name : ""
    turn = local.dns_ready && var.node_count > 0 ? local.turn_fqdn : ""
    sfu  = local.dns_ready && var.node_count > 0 && var.enable_sfu_ports ? local.sfu_fqdn : ""
    nodes = local.dns_ready ? [
      for index in range(var.node_count) : "node-${index + 1}.${var.domain_name}"
    ] : []
  }
}

output "suggested_ice_servers" {
  description = "Template for AGIL_ICE_SERVERS. Replace <TURN_PASSWORD> with the value generated by install.sh; never commit it."
  value = var.node_count > 0 ? jsonencode([
    { urls = "stun:${local.turn_fqdn != "" ? local.turn_fqdn : aws_eip.node[0].public_ip}:${var.turn_port}" },
    {
      urls       = "turn:${local.turn_fqdn != "" ? local.turn_fqdn : aws_eip.node[0].public_ip}:${var.turn_port}?transport=udp"
      username   = "agil"
      credential = "<TURN_PASSWORD>"
    },
    {
      urls       = "turn:${local.turn_fqdn != "" ? local.turn_fqdn : aws_eip.node[0].public_ip}:${var.turn_port}?transport=tcp"
      username   = "agil"
      credential = "<TURN_PASSWORD>"
    },
  ]) : "[]"
}

output "ssh_commands" {
  description = "SSH commands. Requires ssh_key_name to point at an existing key pair and your IP in admin_cidr. With enable_ssm=true use ssm_session_commands instead."
  value = concat(
    ["ssh${var.ssh_key_name != "" ? " -i ${var.ssh_key_name}.pem" : ""} ubuntu@${aws_eip.core.public_ip}"],
    [for ip in aws_eip.node[*].public_ip : "ssh${var.ssh_key_name != "" ? " -i ${var.ssh_key_name}.pem" : ""} ubuntu@${ip}"],
  )
}

output "ssm_session_commands" {
  description = "AWS Session Manager commands. Requires enable_ssm=true (default) and the SSM agent running; no SSH key or open port needed."
  value = concat(
    ["aws ssm start-session --target ${aws_instance.core.id}"],
    [for id in aws_instance.node[*].id : "aws ssm start-session --target ${id}"],
  )
}

output "security_group_ids" {
  description = "Security groups to audit or reuse."
  value = {
    core = aws_security_group.core.id
    node = var.node_count > 0 ? aws_security_group.node[0].id : ""
  }
}

output "next_steps" {
  description = "Copy/paste next steps after apply."
  value       = <<-EOT
    1) DNS: point ${var.domain_name != "" ? var.domain_name : "your hostname"} at ${aws_eip.core.public_ip}
    2) TLS: install Caddy/nginx/HAProxy on the core host and use agil/infra/examples/
    3) On the core host:
         git clone <your-repo> /opt/agil/src
         cd /opt/agil/src/agil/infra/quickstart
         ./install.sh --domain ${var.domain_name != "" ? var.domain_name : "calls.example.com"} --turn-ip ${try(aws_eip.node[0].public_ip, aws_eip.core.public_ip)} --ice-host ${local.turn_fqdn != "" ? local.turn_fqdn : try(aws_eip.node[0].public_ip, var.domain_name)} --start
    4) On each node host (remote-node profile, no local core):
         git clone <your-repo> /opt/agil/src
         cd /opt/agil/src/agil/infra/quickstart
         cp node.env.example .env
         # set TURN_* for this host, then mint a node token on core (dashboard ->
         # Infrastructure, or POST /v1/admin/cluster/tokens) and set:
         #   AGIL_NODE_TOKEN=agil_enr_...
         #   AGIL_CORE_URL=${local.core_private_url}   (same VPC, HTTP)
         #   or AGIL_CORE_URL=${local.core_public_url} (through the TLS proxy)
         docker compose -f docker-compose.node.yml -f docker-compose.node-remote.yml up -d
    5) Verify on the core host: ./smoke.sh && ./doctor.sh
  EOT
}
