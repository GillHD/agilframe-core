# AgilFrame — minimal environment for a REMOTE node/TURN host.
#
# Use this instead of .env.example when this machine runs only the
# node + coturn bundle (docker-compose.node.yml) against a core on another
# host (the AWS reference topology: core VM + node VM):
#
#   cp node.env.example .env
#   # fill AGIL_CORE_URL, AGIL_NODE_TOKEN, TURN_PASSWORD, TURN_EXTERNAL_IP
#   docker compose -f docker-compose.node.yml -f docker-compose.node-remote.yml up -d
#
# There are deliberately NO core secrets here (AGIL_TOKEN_SECRET, AGIL_API_KEYS,
# AGIL_IP_SALT): a TURN/node host does not need them, and copying them here
# would widen the blast radius of a relay compromise. The full .env from the
# core host must not be copied to a node host.
#
# Mint AGIL_NODE_TOKEN on core (dashboard -> Infrastructure, or
# POST /v1/admin/cluster/tokens) and send it over SSH/a secret manager.

# --- image ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=agil-quickstart
AGIL_CORE_IMAGE=agil-calls:0.1.0

# --- core endpoint ----------------------------------------------------------
# Required. Use the core private URL inside one VPC/VNet, or the public HTTPS
# origin through your TLS proxy. Plain HTTP across the internet is not acceptable:
# enrollment tokens and node keys are bearer secrets.
#   same VPC:   http://10.40.10.12:8787
#   public:     https://calls.example.com
AGIL_CORE_URL=

# --- node enrollment --------------------------------------------------------
# One-time token minted on core. Burned on first register; the node key is then
# persisted in the node-state volume.
AGIL_NODE_TOKEN=
# Optional pre-registered key (nk_...) instead of a token.
AGIL_NODE_KEY=
AGIL_NODE_ID=agil-node-1
AGIL_NODE_NAME=agil-node-1
AGIL_NODE_ROLE=sfu
AGIL_NODE_FEATURES=sfu
AGIL_NODE_REGION=
AGIL_NODE_ENDPOINT=
AGIL_NODE_HEARTBEAT_SEC=30

# --- TURN (coturn) ----------------------------------------------------------
# Same values as the core host. The relay range is published 1:1
# (host == container == coturn --min-port/--max-port): open the SAME range on
# the cloud security group and the host firewall.
TURN_REALM=agil.local
TURN_USER=agil
TURN_PASSWORD=
TURN_EXTERNAL_IP=
TURN_BIND_ADDR=0.0.0.0
TURN_PORT=3478
TURN_MIN_PORT=49200
TURN_MAX_PORT=49250
# Dev/LAN only: accept an RFC1918/CGNAT TURN_EXTERNAL_IP (see install.sh).
TURN_ALLOW_PRIVATE_IP=0
# Relay quotas: cap allocations so a leaked demo credential cannot be used as a
# free relay. 0 = unlimited. TURN uses ONE static credential for all clients;
# use coturn's TURN REST API (--use-auth-secret) for customer deployments.
TURN_TOTAL_QUOTA=100
TURN_USER_QUOTA=0
