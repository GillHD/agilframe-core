# AgilFrame — quickstart environment.
#
#   cp .env.example .env
#   ./install.sh            # generates every empty secret below for you
#
# NEVER commit the filled `.env`. It is gitignored, must be mode 0600 and holds
# bearer secrets (API key, TURN password, enrollment token).
#
# Required (compose fails fast when empty): AGIL_PUBLIC_ORIGIN,
# AGIL_TOKEN_SECRET, AGIL_API_KEYS, AGIL_IP_SALT, AGIL_ICE_SERVERS,
# TURN_PASSWORD.
#
# This single file is the source for every service, but the compose model splits
# it: core receives ONLY the AGIL_* app values via an explicit environment list
# (never TURN_PASSWORD / AGIL_NODE_TOKEN / AGIL_NODE_KEY), while node and TURN
# receive only their own values. Do not switch core back to `env_file: .env`.
# For a node/TURN host that talks to a remote core use `node.env.example`.

# --- compose / images -------------------------------------------------------
COMPOSE_PROJECT_NAME=agil-quickstart
# Built from the repo root Dockerfile by default. Pin a registry image if you
# deploy from a prebuilt artefact: registry.example.com/agil/calls:0.1.0
# The node service uses the SAME image and the first-party enrollment CLI.
AGIL_CORE_IMAGE=agil-calls:0.1.0

# --- core: network ----------------------------------------------------------
# 127.0.0.1 = only the local reverse proxy can reach the app. Use 0.0.0.0 only
# when a firewall/security group restricts the port.
AGIL_BIND_ADDR=127.0.0.1
AGIL_HTTP_PORT=8787
# Public URL users see, WITH scheme and no trailing slash. https:// in
# production; http://localhost:8787 for a local trial.
AGIL_PUBLIC_ORIGIN=http://localhost:8787

# --- core: auth and secrets (install.sh fills these) ------------------------
# >=32 random bytes. Rotating it invalidates every issued join token.
AGIL_TOKEN_SECRET=
# `key:tenant,key2:tenant2`. The dashboard logs in with one of these keys.
AGIL_API_KEYS=
# Salt for IP hashing in audit/logs. Rotating it changes stored hashes.
AGIL_IP_SALT=
AGIL_DEFAULT_TENANT=demo
# 0 = only authenticated room creation; 1 = anyone can create a room (demo).
AGIL_ALLOW_ANONYMOUS=0
# Keep 1 only behind a reverse proxy you control (IP/geo headers).
AGIL_TRUST_PROXY=1

# --- core: WebRTC ICE -------------------------------------------------------
# JSON array. install.sh fills STUN + TURN using the values below.
# Example:
# [{"urls":"stun:turn.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"agil","credential":"..."}]
AGIL_ICE_SERVERS=
# Add ?transport=tcp fallbacks for UDP-blocked networks (server-side).
AGIL_ICE_TCP_FALLBACK=1
# Optional JSON object of signing keys indexed by organization and TURN relay ID.
# Set the matching key on each coturn relay using its own secret configuration.
AGIL_COTURN_REST_SECRETS=
# Optional signing keys indexed by organization and enrolled node ID. Nodes opt in with TURN_AUTO_REGISTER=1.
AGIL_COTURN_AUTO_SECRETS=
AGIL_COTURN_REST_TTL_SEC=3600

# --- core: exposure ---------------------------------------------------------
# Optional cluster identity (persisted under AGIL_DATA_DIR/cluster/). Only needed
# when a standby core joins the cluster; leave empty for a standalone core.
# AGIL_CLUSTER_ID=
# AGIL_CLUSTER_ROLE=leader
# Docs/OpenAPI can leak the API surface; disable in a public deployment.
AGIL_DOCS_ENABLED=1
AGIL_ADMIN_API_ENABLED=1
AGIL_MCP_HTTP_ENABLED=0
AGIL_GEO_PROVIDER=header
AGIL_GEO_HEADER_ALLOW=1
# Optional SFU (LiveKit). Leave disabled for the mesh quickstart; see
# agil/core/deploy/livekit/ for a media node.
AGIL_SFU_ENABLED=0
# AGIL_SFU_URL=wss://sfu.example.com
# AGIL_SFU_CONTROL_URL=http://sfu.internal:7880
# AGIL_SFU_API_KEY=
# AGIL_SFU_API_SECRET=

# --- TURN (coturn) ----------------------------------------------------------
TURN_REALM=agil.local
TURN_USER=agil
# install.sh generates a 32-byte hex password.
TURN_PASSWORD=
# Public IPv4 of THIS host (or its 1:1 NAT address). Auto-detected by
# install.sh, which rejects RFC1918/CGNAT/loopback values for a remote origin;
# without a routable address remote clients get an unusable relay candidate.
TURN_EXTERNAL_IP=
# Dev/LAN only: set to 1 (or pass --allow-private-ip) to accept a private
# TURN_EXTERNAL_IP. Never 1 for a customer deployment.
TURN_ALLOW_PRIVATE_IP=0
TURN_BIND_ADDR=0.0.0.0
TURN_PORT=3478
# Relay range. Published 1:1: host range == container range == coturn
# --min-port/--max-port. Open the SAME range on the cloud firewall and the host
# firewall; a shifted mapping produces "ICE connects, no media".
TURN_MIN_PORT=49200
TURN_MAX_PORT=49250
# Allocation quotas (0 = unlimited). TURN uses ONE static shared credential for
# every client: quotas bound relay abuse, but production should use coturn's
# TURN REST API with short-lived credentials.
TURN_TOTAL_QUOTA=100
TURN_USER_QUOTA=0

# --- node (enrollment + heartbeat) -----------------------------------------
# The node service runs the same agil-calls image and the official CLI
# (agil/core/scripts/agil-cli.mjs). State: node-state volume at /app/.data.
# One-time token minted by install.sh or the dashboard. Burned on first
# register; the node keeps a key in the node-state volume.
#
# Core endpoint for the node. In the all-in-one stack the default resolves to
# the local `core` service; on a remote node host set it to the core private
# URL or public HTTPS origin (see node.env.example and docker-compose.node-remote.yml).
# AGIL_CORE_URL=http://core:8787
AGIL_NODE_TOKEN=
# Optional pre-registered key (nk_...) instead of a token.
AGIL_NODE_KEY=
AGIL_NODE_ID=agil-node-1
AGIL_NODE_NAME=agil-node-1
# sfu | turn | stun | all
AGIL_NODE_ROLE=sfu
# Comma list, e.g. sfu,egress
AGIL_NODE_FEATURES=sfu
AGIL_NODE_REGION=
# Informational URL of the media process on this node (not probed yet).
AGIL_NODE_ENDPOINT=
AGIL_NODE_HEARTBEAT_SEC=30
# Optional capacity hint, JSON: {"maxRooms":10,"maxParticipants":500}
# AGIL_NODE_CAPACITY={"maxRooms":10,"maxParticipants":500}
