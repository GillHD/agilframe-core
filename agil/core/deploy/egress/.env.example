# AgilFrame — egress worker environment.
#
# Copy to `.env` in deploy/egress (chmod 600) and fill the values. Never commit
# `.env`. This file is the only place the worker host needs secrets; the
# rendered egress.yaml contains no API keys.
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#   sh render-config.sh
#
# `docker compose` interpolates this file. `render-config.sh` reads the same
# file and renders egress.yaml with the non-secret values (WS URL, Redis
# address/TLS/DB, S3 endpoint/bucket/region and force_path_style). It never
# sources the file as shell code, so quote special characters (see below).

# --- LiveKit / SFU credentials (REQUIRED) ----------------------------------
# Must be the SAME API key/secret as the LiveKit server that dispatches jobs
# (the production SFU). Generate a dedicated pair only if you also configure
# AGIL_EGRESS_API_KEY/SECRET on the app to match; by default the app reuses
# AGIL_SFU_API_KEY/SECRET.
LIVEKIT_API_KEY=agil_sfu
LIVEKIT_API_SECRET=

# --- Egress -> LiveKit ------------------------------------------------------
# Public WSS endpoint the worker joins to capture room media. This is the SFU,
# not the app. Production: wss://sfu.example.com
EGRESS_WS_URL=wss://sfu.example.com
# false for wss://; true only for ws:// on a trusted private network.
EGRESS_INSECURE=false

# --- Egress -> Redis (REQUIRED; same Redis as the SFU) ----------------------
# Default: local SSH tunnel to the SFU's 127.0.0.1:6379:
#   ssh -N -L 127.0.0.1:16379:127.0.0.1:6379 ...
# Private network alternative: e.g. 10.20.0.12:6379.
# `address` is host:port ONLY: never `redis://...`/`rediss://...`.
EGRESS_REDIS_ADDRESS=127.0.0.1:16379
# true for Redis TLS (rediss); false for the loopback tunnel.
EGRESS_REDIS_TLS=false
# Logical Redis database (0..N as configured on the SFU Redis).
EGRESS_REDIS_DB=0
# Leave empty for the loopback tunnel (no Redis AUTH). If the SFU Redis uses
# ACL/AUTH, set both; the password is written to the 0640 rendered file.
# Quote values containing spaces, `#`, `$`, backticks or quotes; see
# render-config.sh. Example: EGRESS_REDIS_PASSWORD='pa$$word#1'
EGRESS_REDIS_USERNAME=
EGRESS_REDIS_PASSWORD=

# --- Storage (S3-compatible) ------------------------------------------------
# The app sends relative output paths, so egress needs durable storage.
# External S3 (recommended for production): https://s3.example.com
# Optional MinIO profile in docker-compose.yml: http://127.0.0.1:9000
EGRESS_S3_ENDPOINT=https://s3.example.com
EGRESS_S3_REGION=ru-msk
EGRESS_S3_BUCKET=agil-recordings
# true for MinIO/Ceph/most RU S3 clones; false for virtual-hosted AWS.
EGRESS_S3_FORCE_PATH_STYLE=true
# Prefer an instance role/workload identity and leave these empty. If static
# keys are unavoidable, keep them here (0600) and rotate regularly.
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET_KEY=

# --- Worker runtime ---------------------------------------------------------
# Host directory bind-mounted at /out (fallback/backup + optional local files).
# Pre-create and give it to the egress UID:
#   install -d -o 1001 -g 1001 -m 750 /srv/agil-egress/out
EGRESS_OUT_DIR=/srv/agil-egress/out
# Host path of the rendered, root-owned 0640 config. Never inside the repo.
EGRESS_CONFIG_FILE=/etc/agil-egress/egress.yaml
# 8 vCPU / 8 GB for one 720p multi-output composite. For single-output-only
# workers, 4.0 / 4g is the documented minimum; also lower
# room_composite_cpu_cost in egress.yaml.
EGRESS_CPUS=8.0
EGRESS_MEM_LIMIT=8g

# --- Optional MinIO profile only -------------------------------------------
# `docker compose --profile minio up -d`. Console binds loopback 9001 only.
MINIO_ROOT_USER=agil-egress
MINIO_ROOT_PASSWORD=
# Object-expiry lifecycle rule applied by minio-init (days; 0 = no rule).
MINIO_RETENTION_DAYS=30

# --- Health checks (scripts/egress-health.mjs) ------------------------------
# Optional app-side verification. The admin key is never logged; read it from
# /root/agil-admin-key.txt on the app VPS or set it in a 0600 file.
# AGIL_APP_URL=https://calls.example.com
# AGIL_ADMIN_KEY=
# Egress container UID/GID (used to verify /out writability when run as root).
# EGRESS_UID=1001
# EGRESS_GID=0
# Optional Redis TLS CA bundle (PEM *path*; the script reads its contents).
# EGRESS_REDIS_CA=/etc/ssl/certs/sfu-redis-ca.pem
# Optional smoke-test inputs (host app token, not a LiveKit token):
# EGRESS_SMOKE_ROOM=
# EGRESS_SMOKE_TOKEN=
# EGRESS_SMOKE_RTMP_URL=rtmp://live.example/app/<stream-key>
# LK_BIN=/usr/local/bin/lk
