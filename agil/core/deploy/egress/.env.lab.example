# AgilFrame — local egress lab environment.
#
#   cd agil/core/deploy/egress
#   cp .env.lab.example .env.lab
#   chmod 600 .env.lab
#   # set LIVEKIT_API_SECRET and MINIO_ROOT_PASSWORD (required)
#   docker compose -f docker-compose.lab.yml --env-file .env.lab up -d --build
#
# Never commit `.env.lab`. The lab reuses one MinIO root account for uploads and
# playback reads; production uses separate least-privilege users (see
# docs/egress-production-s3.md §4).
#
# Generate secrets:
#   openssl rand -hex 32

# --- LiveKit API (required) -------------------------------------------------
# Any non-empty pair works locally; the app and egress use the same values.
LIVEKIT_API_KEY=agil_sfu
LIVEKIT_API_SECRET=

# --- App / API --------------------------------------------------------------
AGIL_PUBLIC_ORIGIN=http://127.0.0.1:8787
AGIL_TOKEN_SECRET=
AGIL_API_KEYS=dev-key:demo

# --- MinIO (required) -------------------------------------------------------
# Use at least 8 characters for the root password (MinIO requirement).
MINIO_ROOT_USER=agil-egress
MINIO_ROOT_PASSWORD=

# Egress uploads and the app playback proxy use this bucket. Keep it private;
# the app serves signed HLS/MP4 URLs, never direct bucket URLs.
EGRESS_S3_BUCKET=agil-recordings
EGRESS_S3_REGION=ru-msk
# Lifecycle expiry for lab artifacts; 0 disables the rule.
MINIO_RETENTION_DAYS=30

# --- Worker runtime ---------------------------------------------------------
# Host directory bind-mounted at /out inside egress (fallback/backup output).
# Pre-create it and make it writable by UID 1001:
#   sudo install -d -o 1001 -g 1001 -m 750 /srv/agil-egress/out
EGRESS_OUT_DIR=/srv/agil-egress/out
EGRESS_CPUS=8.0
EGRESS_MEM_LIMIT=8g

# --- Host ports (defaults shown) -------------------------------------------
# All published on 127.0.0.1 except the RTC UDP range (needed for local clients).
# LAB_REDIS_PORT=6380
# LAB_SFU_HTTP_PORT=7880
# LAB_SFU_RTC_TCP_PORT=7881

# --- Signed playback --------------------------------------------------------
# 15 min default; the dashboard offers 15 min / 1 h / 24 h.
AGIL_EGRESS_PLAYBACK_TTL_SEC=900

# --- Optional smoke helpers (scripts/egress-health.mjs) ---------------------
# AGIL_APP_URL=http://127.0.0.1:8787
# AGIL_ADMIN_KEY=dev-key
# EGRESS_SMOKE_ROOM=
# EGRESS_SMOKE_TOKEN=
