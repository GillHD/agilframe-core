# Local SIP lab keys — NOT production secrets, NOT a carrier account.
#
#   cp .env.example .env
#
# The same key/secret is used by LiveKit SFU, LiveKit SIP and by the AGIL
# Calls server (AGIL_SIP_API_KEY / AGIL_SIP_API_SECRET). LiveKit requires the
# API secret to be at least 32 characters.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=agil-sip-lab-secret-0123456789abcdef
