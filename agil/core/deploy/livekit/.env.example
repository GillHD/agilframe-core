# Copy to `.env` in this directory and fill the secret. Never commit `.env`.
#
# Generate:
#   KEY=agil_sfu_$(openssl rand -hex 4)
#   SECRET=$(openssl rand -hex 32)

# Required by docker-compose.yml (LiveKit reads them via LIVEKIT_KEYS).
LIVEKIT_API_KEY=agil_sfu
LIVEKIT_API_SECRET=

# Same pair under the names the AGIL server will use in S1
# (`scale.sfu.apiKeyEnv` / `apiSecretEnv`). Not read by this compose file.
AGIL_SFU_API_KEY=agil_sfu
AGIL_SFU_API_SECRET=

# Optional host-port overrides (defaults shown).
# SFU_HTTP_PORT=7880
# SFU_RTC_TCP_PORT=7881
# SFU_REDIS_PORT=6380

# Optional egress -> S3/MinIO (only used when the egress profile is enabled).
# EGRESS_S3_ACCESS_KEY=
# EGRESS_S3_SECRET_KEY=
# EGRESS_S3_REGION=ru-msk
# EGRESS_S3_BUCKET=agil-recordings
# EGRESS_S3_ENDPOINT=https://s3.example.com
